{
  "schemaVersion": 1,
  "application": "LeadIntel",
  "service": "leadintel-customer",
  "productionUrl": "https://leadintel.ccgroup.lv",
  "manifestPath": "/release.json",
  "expectedRef": "main",
  "backendHealth": {
    "url": "https://leadintel-api.edgars-7e7.workers.dev/api/health",
    "status": 200,
    "json": {
      "status": "ok",
      "service": "leadintel-api",
      "workflow_version": "approved-workflow-v1"
    }
  },
  "smokeChecks": [
    {
      "id": "customer-shell",
      "type": "text",
      "url": "/customer/",
      "status": 200,
      "contains": [
        "LeadIntel \u2014 Build Your Commercial Intelligence Strategy",
        "id=\"company-website\""
      ]
    },
    {
      "id": "website-input-normalization",
      "type": "text",
      "url": "/customer/website-input-sync.js",
      "status": 200,
      "contains": [
        "toVisibleWebsite",
        "syncVisibleWebsite",
        "displayChanged"
      ]
    },
    {
      "id": "discovery-bootstrap",
      "type": "text",
      "url": "/customer/",
      "status": 200,
      "contains": [
        "<script defer src=\"discovery-ui.js?"
      ],
      "notContains": [
        "<script type=\"module\" src=\"discovery-ui.js"
      ]
    },
    {
      "id": "discovery-runtime",
      "type": "text",
      "url": "/customer/discovery-ui.js",
      "status": 200,
      "contains": [
        "const DISCOVERY_REQUEST_TIMEOUT_MS=25000;",
        "const DISCOVERY_RUN_TIMEOUT_MIN_MS=120000;",
        "function discoveryRunTimeoutMs(",
        "window.LeadIntelDiscoveryUI={open:openDiscoveryFromHandoff};",
        "initDiscoveryWhenReady();",
        "function ensureDiscoveryMounted()"
      ],
      "notContains": [
        "import \"./content-variants.js\"",
        "import './content-variants.js'"
      ]
    },
    {
      "id": "production-entry",
      "type": "text",
      "url": "/",
      "status": 200,
      "contains": [
        "Commercial Intelligence",
        "Contact Intelligence",
        "href=\"customer/\"",
        "href=\"LeadIntel.html\""
      ],
      "notContains": [
        "location.replace('/customer/')",
        "location.replace('/v2/')"
      ]
    },
    {
      "id": "first-party-research",
      "type": "text",
      "url": "/customer/first-party-research.js",
      "status": 200,
      "contains": [
        "collectWebsiteEvidence",
        "planLocalQueries",
        "Insufficient readable company evidence"
      ]
    },
    {
      "id": "approved-workflow-controls",
      "type": "text",
      "url": "/customer/approved-workflow-ui.js",
      "status": 200,
      "contains": [
        "Workflow automation",
        "Take over manually",
        "Approve and start automatic workflow",
        "data-wf-final",
        "if(body&&workspace!==id)",
        "References describe buyers, not your own business.",
        "Total score determines ranking."
      ]
    },
    {
      "id": "qualified-company-list",
      "type": "text",
      "url": "/customer/discovery-engine.js",
      "status": 200,
      "contains": [
        "researchBuyerFit",
        "rankQualifiedCompanies",
        "Buyer fit below the mandatory 50/70 minimum",
        "No recent verified buying signal"
      ]
    },
    {
      "id": "clear-company-results",
      "type": "text",
      "url": "/customer/discovery-ui.js",
      "status": 200,
      "contains": [
        "id=\"clear-company-results\">Clear search results",
        "function clearCompanySearchResults()",
        "pipeline:discovery.pipeline",
        "delete meta.lastCompanyRun"
      ]
    },
    {
      "id": "buyer-failure-recovery",
      "type": "text",
      "url": "/customer/discovery-ui.js",
      "status": 200,
      "contains": [
        "companyResearchIncomplete=true;",
        "Research incomplete",
        "Buyer research saved locally",
        "Company website verification:"
      ]
    },
    {
      "id": "first-party-api-session",
      "type": "text",
      "url": "/api/session",
      "status": 401,
      "contains": [
        "\"authenticated\":false"
      ]
    },
    {
      "id": "first-party-api-transport",
      "type": "text",
      "url": "/customer/api-transport.js",
      "status": 200,
      "contains": [
        "firstPartyUrl",
        "LeadIntelApiTransport"
      ]
    }
  ],
  "retry": {
    "attempts": 12,
    "delayMs": 10000,
    "timeoutMs": 15000
  }
}
