{
  "schemaVersion": 1,
  "application": "LeadIntel",
  "service": "leadintel-customer",
  "productionUrl": "https://leadintel.ccgroup.lv",
  "manifestPath": "/release.json",
  "expectedRef": "main",
  "backendHealth": {
    "url": "https://leadintel-api.edgars-7e7.workers.dev/api/health",
    "status": 200,
    "json": {
      "status": "ok",
      "service": "leadintel-api"
    }
  },
  "smokeChecks": [
    {
      "id": "customer-shell",
      "type": "text",
      "url": "/customer/",
      "status": 200,
      "contains": [
        "LeadIntel — Build Your Commercial Intelligence Strategy",
        "id=\"company-website\""
      ]
    },
    {
      "id": "website-input-normalization",
      "type": "text",
      "url": "/customer/website-input-sync.js",
      "status": 200,
      "contains": [
        "toVisibleWebsite",
        "syncVisibleWebsite",
        "displayChanged"
      ]
    },
    {
      "id": "discovery-bootstrap",
      "type": "text",
      "url": "/customer/",
      "status": 200,
      "contains": [
        "<script defer src=\"discovery-ui.js?"
      ],
      "notContains": [
        "<script type=\"module\" src=\"discovery-ui.js"
      ]
    },
    {
      "id": "discovery-runtime",
      "type": "text",
      "url": "/customer/discovery-ui.js",
      "status": 200,
      "contains": [
        "const DISCOVERY_REQUEST_TIMEOUT_MS=25000;",
        "const DISCOVERY_RUN_TIMEOUT_MS=DISCOVERY_REQUEST_TIMEOUT_MS+1000;",
        "window.LeadIntelDiscoveryUI={open:openDiscoveryFromHandoff};",
        "initDiscoveryWhenReady();",
        "function ensureDiscoveryMounted()"
      ],
      "notContains": [
        "import \"./content-variants.js\"",
        "import './content-variants.js'"
      ]
    },
    {
      "id": "production-entry",
      "type": "text",
      "url": "/",
      "status": 200,
      "contains": [
        "Commercial Intelligence",
        "Contact Intelligence",
        "href=\"customer/\"",
        "href=\"LeadIntel.html\""
      ],
      "notContains": [
        "location.replace('/customer/')",
        "location.replace('/v2/')"
      ]
    }
  ],
  "retry": {
    "attempts": 12,
    "delayMs": 10000,
    "timeoutMs": 15000
  }
}
